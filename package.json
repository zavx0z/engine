{
  "name": "@engine/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Built for MetaFor: reusable high-performance WebGPU infrastructure for immersive interfaces.",
  "homepage": "https://zavx0z.github.io/engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/engine.git"
  },
  "metafor": "https://github.com/zavx0z/metafor",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark:stroked-path": "bun packages/core/benchmarks/stroked-path.ts",
    "build:font": "bun tools/fonts/build-inter-regular.ts",
    "check": "bun run typecheck && bun run test",
    "check:ci": "bun run typecheck && bun run test:ci",
    "test": "bun test packages",
    "test:ci": "bun test packages --path-ignore-patterns='**/*.webgpu.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "bun-webgpu": "^0.1.6",
    "typescript": "^7.0.2"
  }
}
